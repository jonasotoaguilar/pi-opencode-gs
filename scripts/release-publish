#!/usr/bin/env bash
# Release publisher: create the GitHub Release for this tag with base notes.
# The notes are curated afterwards, in place, on the published release.
set -euo pipefail

: "${RELEASE_TAG:?RELEASE_TAG is required}"
: "${GH_TOKEN:?GH_TOKEN is required}"

cd "$(dirname "$0")/.."

if gh release view "$RELEASE_TAG" >/dev/null 2>&1; then
  echo "::notice::release ${RELEASE_TAG} already exists"
else
  gh release create "$RELEASE_TAG" \
    --verify-tag \
    --title "$RELEASE_TAG" \
    --generate-notes
fi
