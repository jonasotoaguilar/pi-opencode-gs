#!/usr/bin/env bash
# Release verification: the published release exists, is not a draft, and it
# points at the commit the tag names.
set -euo pipefail

: "${RELEASE_TAG:?RELEASE_TAG is required}"
: "${GH_TOKEN:?GH_TOKEN is required}"

cd "$(dirname "$0")/.."

draft=$(gh release view "$RELEASE_TAG" --json isDraft --jq '.isDraft')
if [[ "$draft" != "false" ]]; then
  echo "::error::release ${RELEASE_TAG} is a draft or missing"
  exit 1
fi

if [[ -n "${RELEASE_COMMIT:-}" ]]; then
  tagged=$(git rev-parse "${RELEASE_TAG}^{commit}")
  if [[ "$tagged" != "$RELEASE_COMMIT" ]]; then
    echo "::error::tag ${RELEASE_TAG} points at ${tagged}, not ${RELEASE_COMMIT}"
    exit 1
  fi
fi

echo "::notice::release ${RELEASE_TAG} verified"
